{
  "identity": "studio.data-table-result",
  "version": 1,
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["title", "description", "columns", "rows"],
    "properties": {
      "title": {"type": "string", "minLength": 1, "maxLength": 200},
      "description": {"type": "string", "maxLength": 2000},
      "columns": {"type": "array", "minItems": 2, "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 120}},
      "rows": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"type": "object", "additionalProperties": false, "required": ["id", "cells", "source_ids"], "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 64}, "cells": {"type": "array", "minItems": 2, "maxItems": 12, "items": {"type": "string", "maxLength": 2000}}, "source_ids": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string"}}}}}
    }
  }
}
