{
  "identity": "studio.output-request",
  "version": 1,
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["kind", "locale", "source_ids"],
    "properties": {
      "kind": {"enum": ["report", "flashcards", "mind_map", "data_table"]},
      "locale": {"type": "string", "minLength": 2, "maxLength": 16},
      "source_ids": {"type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
    }
  }
}
