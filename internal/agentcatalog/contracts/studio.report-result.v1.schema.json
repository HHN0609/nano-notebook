{
  "identity": "studio.report-result",
  "version": 1,
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["title", "summary", "sections"],
    "properties": {
      "title": {"type": "string", "minLength": 1, "maxLength": 200},
      "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
      "sections": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "object", "additionalProperties": false, "required": ["id", "heading", "markdown", "source_ids"], "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 64}, "heading": {"type": "string", "minLength": 1, "maxLength": 200}, "markdown": {"type": "string", "minLength": 1, "maxLength": 12000}, "source_ids": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string"}}}}}
    }
  }
}
