{
  "identity": "studio.flashcards-result",
  "version": 1,
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["title", "cards"],
    "properties": {
      "title": {"type": "string", "minLength": 1, "maxLength": 200},
      "cards": {"type": "array", "minItems": 5, "maxItems": 24, "items": {"type": "object", "additionalProperties": false, "required": ["id", "front", "back", "source_ids"], "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 64}, "front": {"type": "string", "minLength": 1, "maxLength": 500}, "back": {"type": "string", "minLength": 1, "maxLength": 2000}, "source_ids": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string"}}}}}
    }
  }
}
