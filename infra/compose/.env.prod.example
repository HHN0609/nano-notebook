# Production environment variables.
# Copy this file to infra/compose/.env and fill in real values.
#
# API keys
DASHSCOPE_API_KEY=replace-with-your-dashscope-api-key
GEMINI_API_KEY=replace-with-your-gemini-api-key
NANO_GENERATION_PROVIDER=aliyun
NANO_GENERATION_MODEL=qwen-plus
BIFROST_URL=http://bifrost:56666

# Generation secrets passed through to Bifrost via env_file
