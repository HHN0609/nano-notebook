#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

go mod download
if [ -d web ]; then
  npm --prefix web install
fi
if [ -d services/web-reader ]; then
  npm --prefix services/web-reader install
fi
docker compose -f infra/compose/compose.yaml pull postgres clickhouse kafka minio qdrant bifrost jaeger prometheus grafana
docker compose -f infra/compose/compose.yaml build document-renderer web-reader
